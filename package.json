{
  "name": "far-wake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "icons": "tsx scripts/make-icons.ts",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
